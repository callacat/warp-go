<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="warp-go"
        Arguments=""
        InstallLocation="C:\Program Files\callacat\warp-go GUI">
    </Installer>
    <PackageInformation
        PackageName="warp-go GUI"
        PackageDisplayName="warp-go GUI"
        PublisherName="CN=callacat"
        PublisherDisplayName="callacat"
        Version="0.1.0.0"
        PackageDescription="A warp-go application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.callacat.warpgo"
                Description="A warp-go application"
                DisplayName="warp-go GUI"
                ExecutableName="warp-go"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>warp-go GUI</DisplayName>
            <PublisherDisplayName>callacat</PublisherDisplayName>
            <Description>A warp-go application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="warp-go.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
